{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/fajr",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/daily-post?slot=morning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/daily-post?slot=evening",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/ig-refresh",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/watchdog?slot=morning",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/watchdog",
      "schedule": "40 20 * * *"
    },
    {
      "path": "/api/learn-review?dry=0",
      "schedule": "45 5 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/webhook/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ]
}